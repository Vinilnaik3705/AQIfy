# Frontend settings
VITE_API_BASE_URL=http://localhost:8001

# Backend settings
DATABASE_URL=sqlite:///./aqify.db
JWT_SECRET=change-me-in-production
SECRET_KEY=change-me-in-production
PUBLIC_BASE_URL=http://localhost:8001
