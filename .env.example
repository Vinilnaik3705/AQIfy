# Frontend settings
VITE_API_BASE_URL=http://localhost:8001

# Backend settings
APP_ENV=development
DATABASE_URL=sqlite:///./aqify.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Optional in development (an ephemeral secret is generated); required in production
JWT_SECRET=
JWT_EXPIRE_MINUTES=120
PUBLIC_BASE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_BACKGROUND_JOBS=true
# Training is request-driven by default; opt in to a single-city warm-up only.
ENABLE_STARTUP_TRAINING=false
STARTUP_TRAIN_CITIES=delhi
MODEL_CACHE_MAX_CITIES=4

# Reserved admin/authority/inspector accounts (required in production; optional in development)
DEFAULT_ADMIN_PASSWORD=
DEFAULT_AUTHORITY_PASSWORD=
DEFAULT_INSPECTOR_PASSWORD=

# Optional mail configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@example.com
# RESEND_API_KEY=
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# GOOGLE_API_KEY=

# Production database (Render / Neon / Supabase PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
