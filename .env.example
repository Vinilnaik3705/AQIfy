# Reserved admin/authority/inspector accounts
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_AUTHORITY_PASSWORD=Authority@12345
DEFAULT_INSPECTOR_PASSWORD=Inspector@12345

